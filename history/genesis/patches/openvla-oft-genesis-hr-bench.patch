+def _hf_component_filename(repo_id: str, component_name: str, known_filenames: Dict[str, str]) -> str:
+    if repo_id in known_filenames:
+        return known_filenames[repo_id]
+
+    files = HfApi().list_repo_files(repo_id=repo_id)
+    prefix = f"{component_name}--"
+    candidates = [f for f in files if os.path.basename(f).startswith(prefix) and f.endswith("_checkpoint.pt")]
+    if not candidates:
+        raise ValueError(f"No {component_name} checkpoint found in HF repo {repo_id}")
+
+    def _step(filename: str) -> int:
+        stem = os.path.basename(filename)
+        try:
+            return int(stem.split("--", 1)[1].split("_checkpoint.pt", 1)[0])
+        except Exception:
+            return -1
+
+    return max(candidates, key=_step)
+
+
