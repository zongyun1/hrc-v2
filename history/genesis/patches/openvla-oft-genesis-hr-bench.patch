+def genesis_hr_bench_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
+    # Built by scripts/build_genesis_hr_bench_rlds.py:
+    #   action[:, :6] = [delta xyz, delta rpy_sxyz]
+    #   action[:, -1] = gripper in [0, 1] with 1=closed
+    #   state[:, :6] = [xyz, rpy_sxyz]
+    #   state[:, -1] = gripper in [0, 1] with 1=closed
+    trajectory["observation"]["EEF_state"] = trajectory["observation"]["state"][:, :6]
+    trajectory["observation"]["gripper_state"] = trajectory["observation"]["state"][:, -1:]
+    return trajectory
+
