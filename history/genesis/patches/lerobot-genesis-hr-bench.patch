+def _episode_stats_from_row(row: dict, features: dict) -> dict:
+    episode_stats = {}
+    for key, value in row.items():
+        if not str(key).startswith("stats/"):
+            continue
+        stat_key = str(key).replace("stats/", "", 1)
+        parts = stat_key.split("/")
+        if len(parts) != 2:
+            continue
+        feature_name, stat_name = parts
+        if feature_name not in episode_stats:
+            episode_stats[feature_name] = {}
+
+        if feature_name in features:
+            feature_dtype = features[feature_name].get("dtype")
+            if feature_dtype in {"image", "video"} and stat_name != "count":
+                value = np.asarray(value)
+                if value.dtype == object:
+                    flat_values = []
+                    for item in value:
+                        while isinstance(item, np.ndarray):
+                            item = item.flatten()[0]
+                        flat_values.append(item)
+                    value = np.array(flat_values, dtype=np.float64).reshape(3, 1, 1)
+                elif value.shape == (3,):
+                    value = value.reshape(3, 1, 1)
+
+        episode_stats[feature_name][stat_name] = value
+    return episode_stats
+
+
+def _selected_episode_stats(dataset):
+    if getattr(dataset, "episodes", None) is None:
+        return dataset.meta.stats
+
+    stats = []
+    for episode_idx in dataset.episodes:
+        row_stats = _episode_stats_from_row(dataset.meta.episodes[episode_idx], dataset.meta.features)
+        if row_stats:
+            stats.append(row_stats)
+
+    if not stats:
+        episode_files = sorted((Path(dataset.meta.root) / "meta" / "episodes").glob("chunk-*/file-*.parquet"))
+        if not episode_files:
+            return dataset.meta.stats
+        episodes = pd.concat((pd.read_parquet(path) for path in episode_files), ignore_index=True)
+        selected = set(int(idx) for idx in dataset.episodes)
+        for _, row in episodes[episodes["episode_index"].isin(selected)].iterrows():
+            row_stats = _episode_stats_from_row(row.to_dict(), dataset.meta.features)
+            if row_stats:
+                stats.append(row_stats)
+
+    return aggregate_stats(stats) if stats else dataset.meta.stats
+
