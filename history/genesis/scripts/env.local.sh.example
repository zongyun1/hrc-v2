#!/bin/bash
# Copy this file to scripts/env.local.sh and edit for your cluster.
#
#   cp scripts/env.local.sh.example scripts/env.local.sh
#   $EDITOR scripts/env.local.sh
#
# scripts/env.local.sh is gitignored — every collaborator can have their own.
# Anything you set here overrides the defaults in scripts/env.sh.
#
# You only need to set the variables that are wrong for your cluster.
# Comment out the rest.

# --- Python interpreters (REQUIRED on a new cluster) -----------------------
# Easiest: set VLA_ENV_ROOT to the parent dir holding every per-baseline venv
# (MAWM/, openvla_oft/, lerobot/, rdt/, octo/, ...). env.sh derives MAWM_PY,
# OFT_PY, LEROBOT_PY and RDT_PY from it automatically.
# VLA_ENV_ROOT=/path/to/envs

# Or point at each interpreter individually (overrides the VLA_ENV_ROOT
# derivation). MAWM_PY is the one env.sh falls back on to locate VLA_ENV_ROOT.
# MAWM_PY=/path/to/your/MAWM/bin/python
# OFT_PY=/path/to/your/openvla_oft/bin/python
# LEROBOT_PY=/path/to/your/lerobot/bin/python      # smolvla / pi0 / pi05 / pi0_fast
# RDT_PY=/path/to/your/rdt/bin/python

# --- SLURM finetune launcher knobs (cluster-dependent) ---------------------
# Read by `scripts/finetune.sh --slurm` when it builds the sbatch command for
# the generic scripts/finetune.sbatch. Set these to your cluster's names.
#
# FT_CONSTRAINT / FT_ACCOUNT may be left empty — the corresponding sbatch flag
# is then omitted. FT_GRES is the gres resource name: most clusters use "gpu"
# (so --gres=gpu:N); some require a typed name like "gpu:a100".
#
# FT_PARTITION=gpu-preempt
# FT_CONSTRAINT="a100|h100|l40s|a40"
# FT_ACCOUNT=
# FT_GRES=gpu

# CUDA toolkit for RDT (its DeepSpeed needs CUDA_HOME at import). finetune_rdt.sh
# `module load`s CUDA_MODULE if CUDA_HOME isn't already set. Set the module name
# your cluster uses, or export CUDA_HOME directly.
# CUDA_MODULE=cuda/12.1
# CUDA_HOME=/usr/local/cuda

# --- SLURM legacy knobs (scripts/vla_data/* tooling) -----------------------
# Only relevant if you use the data-collection sbatch helpers. The static
# `#SBATCH` lines inside those scripts are NOT controlled by these vars —
# override those at submission time instead.
#
# SLURM_CPU_PARTITION=cpu
# SLURM_GPU_PARTITION=gpu
# SLURM_GPU_PREEMPT_PARTITION=gpu-preempt
# SLURM_GPU_CONSTRAINT="a100|l40s|a40"
